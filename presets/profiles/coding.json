{
  "$schema": "https://opencode.ai/config.json",
  "model": "apmix/claude-sonnet-4-6-free",
  "small_model": "opencode/nemotron-3.5-lightning-free",
  
  "instructions": [
    "/data/data/com.termux/files/home/.config/opencode/instructions/termux-core.md"
