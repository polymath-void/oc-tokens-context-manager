{
  "$schema": "https://opencode.ai/config.json",
  "model": "apmix/claude-sonnet-4-6-free",
  "small_model": "opencode/nemotron-3.5-lightning-free",
  
  "extends": "profiles/minimal.json",
  
  "instructions": [
    "/data/data/com.termux/files/home/.config/opencode/instructions/termux-core.md",
    "/data/data/com.termux/files/home/Projects/AGENTS.md"
  ],
  
  "skills": {
    "paths": [
      "/data/data/com.termux/files/home/.gemini/config/skills",
      "/data/data/com.termux/files/home/Projects/.agents/skills",
      "/data/data/com.termux/files/home/.gemini/antigravity-cli/builtin/skills"
    ],
    "autoload": false
  },
  
  "context": {
    "max_tokens": 150000,
    "summarization": {
      "enabled": true,
      "threshold": 120000,
      "target_size": 80000,
      "preserve_recent": 20000,
      "strategy": "progressive",
      "adaptive": true,
      "model_aware": true
    },
    "ml_preload": {
      "enabled": false,
      "model": "usage_patterns",
      "confidence_threshold": 0.7
    },
    "analytics": {
      "enabled": true,
      "track_tokens": true,
      "track_skills": true,
      "export_format": "json"
    }
  }
}
